<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Wearia" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <!-- Status bar & Windows Background -->
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowBackground">@color/colorBackground</item>

        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>

        <!-- Default Material Component styles -->
        <item name="materialButtonStyle">@style/Widget.Wearia.Button.Pill</item>
        <item name="materialCardViewStyle">@style/Widget.Wearia.Card</item>
        <item name="chipStyle">@style/Widget.Wearia.Chip</item>
        <item name="bottomNavigationStyle">@style/Widget.Wearia.BottomNav</item>
    </style>

    <!-- Bouton Pill Violet Principal -->
    <style name="Widget.Wearia.Button.Pill" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="cornerRadius">@dimen/pill_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Bouton Dégradé de Marque (Turquoise -> Violet) -->
    <style name="Widget.Wearia.Button.Gradient" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_brand_gradient</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">@dimen/pill_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">3dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Bouton Pill Outline / Secondaire -->
    <style name="Widget.Wearia.Button.Pill.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="strokeColor">@color/colorBorderStrong</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">@dimen/pill_corner_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Carte standard 20dp avec bordure subtile et ombre douce -->
    <style name="Widget.Wearia.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorSurfaceCard</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Grande Carte Héros 28dp -->
    <style name="Widget.Wearia.Card.Hero" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorSurfaceCard</item>
        <item name="cardCornerRadius">@dimen/hero_card_corner_radius</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/colorBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Style Chip Pill Moderne -->
    <style name="Widget.Wearia.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
        <item name="chipBackgroundColor">@color/colorSurface</item>
        <item name="chipStrokeColor">@color/colorBorder</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAlignment">center</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Sélection explicite pour les choix de l’AI Shopper -->
    <style name="Widget.Wearia.ShopperChoiceChip" parent="Widget.Wearia.Chip">
        <item name="chipBackgroundColor">@color/shopper_choice_chip_background</item>
        <item name="chipStrokeColor">@color/shopper_choice_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/shopper_choice_chip_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Bottom Navigation Bar moderne et flottante -->
    <style name="Widget.Wearia.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="elevation">12dp</item>
        <item name="itemRippleColor">#1A6C47FF</item>
    </style>

    <!-- Typographie Moderne -->
    <style name="Wearia.Text.Display" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Wearia.Text.Title" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Wearia.Text.Title.Serif">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="Wearia.Text.Subtitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Wearia.Text.Subtitle.Serif">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>

    <style name="Wearia.Text.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Wearia.Text.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/colorTextMuted</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
