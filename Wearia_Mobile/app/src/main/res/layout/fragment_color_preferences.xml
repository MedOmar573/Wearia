<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="44dp">

        <!-- Titre & Sous-titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vos Préférences Couleurs"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Indiquez à Wearia les nuances que vous appréciez porter au quotidien."
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Section 1 : Couleurs adorées -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couleurs favorites (Aime)"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="12dp" />

        <!-- Grid 4 colonnes des couleurs préférées -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_preferred_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="28dp" />

        <!-- Section 2 : Couleurs à éviter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couleurs à éviter (N'aime pas)"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="12dp" />

        <!-- Grid des couleurs à éviter -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_avoid_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="36dp" />

        <!-- Bouton Continuer -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_continue_colors"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Enregistrer &amp; Continuer"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                style="@style/Widget.Wearia.Button.Pill" />

            <ProgressBar
                android:id="@+id/progress_bar_colors"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/colorOnPrimary"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
