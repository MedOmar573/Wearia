<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="40dp"
        android:gravity="center_horizontal">

        <!-- En-tête : Bouton retour -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_close_modern"
                android:contentDescription="Retour"
                app:tint="@color/colorTextPrimary" />
        </FrameLayout>

        <!-- Logo Wearia -->
        <ImageView
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_logo_wearia"
            android:contentDescription="Wearia Logo"
            android:adjustViewBounds="true"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Code de vérification"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saisissez le code à 6 chiffres envoyé à :"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_email_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="utilisateur@email.com"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- 6 cases pour le code OTP -->
        <LinearLayout
            android:id="@+id/layout_otp_inputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <EditText
                android:id="@+id/et_otp_1"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <EditText
                android:id="@+id/et_otp_2"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <EditText
                android:id="@+id/et_otp_3"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <EditText
                android:id="@+id/et_otp_4"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <EditText
                android:id="@+id/et_otp_5"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <EditText
                android:id="@+id/et_otp_6"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_otp_box"
                android:gravity="center"
                android:inputType="number"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Bouton Valider -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_verify_otp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Valider le code"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:includeFontPadding="false"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/colorPrimary"
            android:textColor="@color/colorOnPrimary"
            android:layout_marginBottom="24dp" />

        <!-- Renvoyer le code -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_resend_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vous n'avez pas reçu le code ?"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_resend_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Renvoyer un nouveau code"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
