<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:paddingHorizontal="18dp"
    android:paddingTop="24dp">

    <!-- En-tête Mes Tenues -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mes Tenues"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary"
        android:layout_marginBottom="16dp" />

    <!-- Onglets Segmentés Favoris / Historique -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/tab_favorites"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_tab_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favoris"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp" />

            <View
                android:id="@+id/indicator_favorites"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@drawable/bg_brand_gradient" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_tab_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historique"
                android:textSize="15sp"
                android:textColor="@color/colorTextSecondary"
                android:paddingBottom="8dp" />

            <View
                android:id="@+id/indicator_history"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chips Catégories d'Occasions -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_occasions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_occasion_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toutes"
                android:checked="true"
                style="@style/Widget.Wearia.Chip"
                app:chipBackgroundColor="@color/colorPrimary"
                android:textColor="@color/colorOnPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_occasion_university"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Université"
                style="@style/Widget.Wearia.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_occasion_work"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Travail"
                style="@style/Widget.Wearia.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_occasion_outings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sorties"
                style="@style/Widget.Wearia.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_occasion_events"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Événements"
                style="@style/Widget.Wearia.Chip" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="gone"
        android:layout_marginVertical="24dp" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Aucune tenue enregistrée pour le moment.\nGénérez une tenue et touchez 'J'aime' pour la retrouver ici."
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:visibility="gone"
        android:padding="32dp" />

    <!-- Grid 2 colonnes des tenues -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_outfits"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="28dp" />

</LinearLayout>
