<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Guide / Cadre viseur central avec coins arrondis et bordure dégradée -->
    <View
        android:id="@+id/view_finder_frame"
        android:layout_width="290dp"
        android:layout_height="380dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="#20FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ligne de scan IA -->
    <View
        android:id="@+id/view_scan_line"
        android:layout_width="280dp"
        android:layout_height="2dp"
        android:background="@drawable/bg_brand_gradient"
        app:layout_constraintTop_toTopOf="@id/view_finder_frame"
        app:layout_constraintStart_toStartOf="@id/view_finder_frame"
        app:layout_constraintEnd_toEndOf="@id/view_finder_frame" />

    <!-- Bouton Fermer Caméra -->
    <ImageButton
        android:id="@+id/btn_close_camera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_button"
        android:backgroundTint="#80000000"
        android:src="@drawable/ic_close"
        app:tint="#FFFFFF"
        android:layout_marginStart="20dp"
        android:layout_marginTop="36dp"
        android:contentDescription="Retour"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Badge Statut IA en haut -->
    <TextView
        android:id="@+id/tv_classify_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cadrez votre vêtement au centre"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingHorizontal="18dp"
        android:paddingVertical="9dp"
        android:background="@drawable/bg_brand_gradient"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Indicateur de progression -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/colorSecondary"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_capture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="20dp" />

    <!-- Bouton Galerie -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_gallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        app:fabSize="normal"
        app:backgroundTint="#CCFFFFFF"
        app:tint="@color/colorTextPrimary"
        android:contentDescription="Importer depuis la galerie"
        app:srcCompat="@drawable/ic_search_modern"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_capture"
        app:layout_constraintTop_toTopOf="@id/btn_capture"
        app:layout_constraintEnd_toStartOf="@id/btn_capture" />

    <!-- Bouton Capture Principal -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_capture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="44dp"
        app:fabCustomSize="74dp"
        app:maxImageSize="36dp"
        app:backgroundTint="#FFFFFF"
        app:tint="@color/colorPrimary"
        android:contentDescription="Capturer le vêtement"
        app:srcCompat="@android:drawable/ic_menu_camera"
        app:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
