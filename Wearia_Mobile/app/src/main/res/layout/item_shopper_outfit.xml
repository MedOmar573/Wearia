<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/colorSurfaceCard"
    app:strokeColor="@color/colorBorder"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tête : Titre tenue + Badge Match -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_outfit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Option 1 • Streetwear"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    tools:ignore="HardcodedText" />

                <!-- Prix total + Statut budget -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/tv_outfit_total_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="228.9 TND"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/tv_outfit_budget_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" · Dans le budget"
                        android:textSize="12sp"
                        android:textColor="@color/colorSuccess"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>

            <!-- Badge Score Match -->
            <TextView
                android:id="@+id/tv_outfit_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 99%"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/badge_haut_text"
                android:background="@drawable/bg_badge_haut"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Explication stylistique sobre -->
        <TextView
            android:id="@+id/tv_outfit_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Combinaison harmonieuse de pièces réelles."
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_clothing_item_preview"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            tools:ignore="HardcodedText" />

        <!-- Diviseur -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorBorder"
            android:layout_marginBottom="12dp" />

        <!-- Conteneur des articles de la tenue -->
        <LinearLayout
            android:id="@+id/ll_outfit_articles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
