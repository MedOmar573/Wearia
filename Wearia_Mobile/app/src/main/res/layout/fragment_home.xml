<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- En-tête Salutation (Serif élégant comme 12.jpg) -->
        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good morning, Ameni 👋"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="18dp" />

        <!-- Weather Card (12.jpg) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorSurface"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <!-- Location & Température -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="12sp"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tv_city_weather_quick"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tunis"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_temperature_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌙 19°C"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Condition Météo -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☀️ Sunny"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>

                <!-- Vent / Climat -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍃 Light wind"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Outfit of the day Hero Card (12.jpg) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_today_outfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/colorSurface"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header de la carte avec étoiles -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_sparkle"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Outfit of the day"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:textColor="@color/colorTextPrimary" />
                </LinearLayout>

                <!-- Loading State -->
                <ProgressBar
                    android:id="@+id/pb_outfit_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/colorPrimary"
                    android:visibility="gone"
                    android:layout_marginVertical="24dp" />

                <!-- Layout pour quand il y a une tenue -->
                <LinearLayout
                    android:id="@+id/layout_outfit_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Collage d'aperçu de la tenue (Chemise, Pantalon, Veste, Chaussures) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_outfit_collage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="@drawable/bg_clothing_item_preview"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/iv_outfit_top"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:scaleType="fitCenter"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/iv_outfit_bottom" />

                        <ImageView
                            android:id="@+id/iv_outfit_bottom"
                            android:layout_width="80dp"
                            android:layout_height="160dp"
                            android:scaleType="fitCenter"
                            app:layout_constraintStart_toEndOf="@+id/iv_outfit_top"
                            app:layout_constraintEnd_toStartOf="@+id/iv_outfit_jacket"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <ImageView
                            android:id="@+id/iv_outfit_jacket"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:scaleType="fitCenter"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_outfit_bottom" />

                        <ImageView
                            android:id="@+id/iv_outfit_shoes"
                            android:layout_width="70dp"
                            android:layout_height="50dp"
                            android:scaleType="fitCenter"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="8dp" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Tags / Badges pastels (Casual, University, Weather suitable) -->
                    <LinearLayout
                        android:id="@+id/layout_outfit_tags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="18dp">

                        <TextView
                            android:id="@+id/tag_style"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Casual"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/chipPeachText"
                            android:background="@drawable/bg_badge_peach"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tag_occasion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="University"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/chipPinkText"
                            android:background="@drawable/bg_badge_pink"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tag_weather"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weather suitable"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/chipBlueText"
                            android:background="@drawable/bg_badge_blue" />
                    </LinearLayout>

                    <!-- Bouton View outfit (Pill noir mat) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_outfit"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="View outfit"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:includeFontPadding="false"
                        app:cornerRadius="27dp"
                        app:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/colorOnPrimary" />
                </LinearLayout>

                <!-- État vide : Si la garde-robe est vide -->
                <LinearLayout
                    android:id="@+id/layout_outfit_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_clothing_item_preview"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="26dp"
                    android:visibility="visible">

                    <!-- Icône Cintre dans un cercle blanc -->
                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_button"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hanger"
                            app:tint="@color/colorTextPrimary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_empty_outfit_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Garde-robe vide"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_empty_outfit_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Votre garde-robe ne contient aucun vêtement.\nAjoutez des pièces pour que l'IA compose votre tenue !"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary"
                        android:textAlignment="center"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Bouton Ajouter un vêtement -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_empty_add_clothing"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="+ Ajouter un vêtement"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="20dp"
                        app:cornerRadius="22dp"
                        app:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/colorOnPrimary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section: What do you want to do? -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What do you want to do?"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="14dp" />

        <!-- 2x2 Grid de cartes actions (12.jpg) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- Action 1: Generate outfit -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_add"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Generate outfit"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action 2: My wardrobe -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_dressing"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👗"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My wardrobe"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action 3: Favorites -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_favorites"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖤"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Favorites"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action 4: Personal Shopper -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_shopping"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurface"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛍️"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal Shopper"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
