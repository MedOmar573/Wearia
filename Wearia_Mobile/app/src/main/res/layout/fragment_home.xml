<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- En-tête Salutation & Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bonjour, Ameni"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prêt(e) pour composer votre tenue du jour ?"
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Weather Card Moderne (Pill & Icônes vectorielles) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorSurfaceCard"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="1dp"
            android:layout_marginBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp">

                <!-- Localisation & Température -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_search_modern"
                            app:tint="@color/colorPrimary"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tv_city_weather_quick"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tunis"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_temperature_home"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="19°C"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Condition Météo avec icône vectorielle -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_badge_veste"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_sun"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ensoleillé"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/badge_veste_text" />
                </LinearLayout>

                <!-- Vent doux avec icône vectorielle -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_badge_accessoire"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_wind"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brise légère"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/badge_accessoire_text" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Outfit of the day Hero Card (Coins 28dp) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_today_outfit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/colorSurfaceCard"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="1dp"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header de la carte avec sparkle et titre -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sparkle_filled"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tenue du jour"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conseil IA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:background="@drawable/bg_badge_haut"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <!-- Loading State -->
                <ProgressBar
                    android:id="@+id/pb_outfit_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/colorPrimary"
                    android:visibility="gone"
                    android:layout_marginVertical="28dp" />

                <!-- Layout pour quand il y a une tenue -->
                <LinearLayout
                    android:id="@+id/layout_outfit_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Collage d'aperçu de la tenue -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_outfit_collage"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:background="@drawable/bg_clothing_item_preview"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/iv_outfit_top"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:scaleType="fitCenter"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/iv_outfit_bottom" />

                        <ImageView
                            android:id="@+id/iv_outfit_bottom"
                            android:layout_width="85dp"
                            android:layout_height="170dp"
                            android:scaleType="fitCenter"
                            app:layout_constraintStart_toEndOf="@+id/iv_outfit_top"
                            app:layout_constraintEnd_toStartOf="@+id/iv_outfit_jacket"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <ImageView
                            android:id="@+id/iv_outfit_jacket"
                            android:layout_width="100dp"
                            android:layout_height="110dp"
                            android:scaleType="fitCenter"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_outfit_bottom" />

                        <ImageView
                            android:id="@+id/iv_outfit_shoes"
                            android:layout_width="75dp"
                            android:layout_height="55dp"
                            android:scaleType="fitCenter"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="8dp" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Badges pastels officiels (Score %, Occasion, Météo) -->
                    <LinearLayout
                        android:id="@+id/layout_outfit_tags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="18dp">

                        <TextView
                            android:id="@+id/tag_style"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="95% match"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/badge_haut_text"
                            android:background="@drawable/bg_badge_haut"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tag_occasion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quotidien"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/badge_robe_text"
                            android:background="@drawable/bg_badge_robe"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/tag_weather"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20°C adapté"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/badge_bas_text"
                            android:background="@drawable/bg_badge_bas"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp" />
                    </LinearLayout>

                    <!-- Bouton Dégradé Brand Gradient Pill -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_outfit"
                        style="@style/Widget.Wearia.Button.Gradient"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Voir la tenue complète"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- État vide : Si la garde-robe est vide -->
                <LinearLayout
                    android:id="@+id/layout_outfit_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_clothing_item_preview"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="28dp"
                    android:visibility="visible">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_badge_haut"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_hanger"
                            app:tint="@color/colorPrimary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_empty_outfit_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Garde-robe vide"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_empty_outfit_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Votre garde-robe ne contient aucun vêtement.\nAjoutez des pièces pour que l'IA compose votre tenue !"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary"
                        android:textAlignment="center"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Bouton Ajouter un vêtement Dégradé -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_empty_add_clothing"
                        style="@style/Widget.Wearia.Button.Gradient"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:text="+ Ajouter un vêtement"
                        android:textSize="13sp"
                        android:paddingHorizontal="22dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Titre Section Actions Rapides -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Que souhaitez-vous faire ?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="14dp" />

        <!-- Grille 2x2 des Actions Rapides modernisées -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- Action 1: Recommander une tenue -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_add"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sparkle_filled"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Créer une tenue"
                        android:textAlignment="center"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action 2: Dressing -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_dressing"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_nav_wardrobe"
                        app:tint="@color/colorSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon Dressing"
                        android:textAlignment="center"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action 3: Favoris -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_favorites"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_heart_filled"
                        app:tint="#F43F5E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mes Favoris"
                        android:textAlignment="center"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action 4: Personal Shopper -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_shopping"
                android:layout_width="0dp"
                android:layout_height="105dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_nav_shopper"
                        app:tint="#F59E0B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Personal Shopper"
                        android:textAlignment="center"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
