<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="44dp">

        <!-- Titre & Sous-titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profil de Style &amp; Morphologie"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Renseignez vos caractéristiques pour personnaliser les recommandations IA."
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <!-- Section: Informations principales -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informations principales"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="12dp" />

        <!-- Choix du Genre (Homme / Femme) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Genre"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Option Homme -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gender_man"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/colorPrimary"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_sparkle_filled"
                        app:tint="@color/colorPrimary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_gender_man"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Homme"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option Femme -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_gender_woman"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorBorder"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_sparkle_filled"
                        app:tint="@color/colorSecondary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_gender_woman"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Femme"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Taille & Poids -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Carte Height -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Taille"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="4dp">

                        <EditText
                            android:id="@+id/et_height"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="170"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"
                            android:background="@null"
                            android:inputType="number" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" cm"
                            android:textSize="14sp"
                            android:textColor="@color/colorTextPrimary"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte Weight -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Poids"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="4dp">

                        <EditText
                            android:id="@+id/et_weight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"
                            android:background="@null"
                            android:inputType="number" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" kg"
                            android:textSize="14sp"
                            android:textColor="@color/colorTextPrimary"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Section: Mensurations optionnelles -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensurations complémentaires"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="12dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:layout_marginBottom="24dp">

            <!-- Épaules -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_shoulders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Épaules"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />
                    <TextView
                        android:id="@+id/tv_shoulders_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Ajouter"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Poitrine -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_chest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Poitrine"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />
                    <TextView
                        android:id="@+id/tv_chest_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Ajouter"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Taille -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_waist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tour de taille"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />
                    <TextView
                        android:id="@+id/tv_waist_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Ajouter"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hanches -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hanches"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />
                    <TextView
                        android:id="@+id/tv_hips_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Ajouter"
                        android:textSize="13sp"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- Section: Coupe préférée -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coupe préférée"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/chip_fit_fitted"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Ajustée"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/colorTextPrimary"
                android:background="@drawable/bg_badge_outline"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chip_fit_regular"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Régulière"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/colorOnPrimary"
                android:background="@drawable/bg_badge_taupe"
                android:layout_marginHorizontal="3dp" />

            <TextView
                android:id="@+id/chip_fit_oversized"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Oversize"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/colorTextPrimary"
                android:background="@drawable/bg_badge_outline"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Section: Styles favoris -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Styles vestimentaires favoris"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_styles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_style_casual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Casual"
                android:checked="true"
                style="@style/Widget.Wearia.Chip"
                app:chipBackgroundColor="@color/colorSecondary"
                android:textColor="@color/colorOnPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_style_classic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classique"
                android:checked="true"
                style="@style/Widget.Wearia.Chip"
                app:chipBackgroundColor="@color/colorSecondary"
                android:textColor="@color/colorOnPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_style_streetwear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streetwear"
                style="@style/Widget.Wearia.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_style_elegant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Élégant"
                style="@style/Widget.Wearia.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_style_sporty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sportswear"
                style="@style/Widget.Wearia.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_style_minimal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minimaliste"
                style="@style/Widget.Wearia.Chip" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Bouton Continuer -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_continue_profile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Enregistrer &amp; Continuer"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                style="@style/Widget.Wearia.Button.Pill" />

            <ProgressBar
                android:id="@+id/progress_bar_profile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/colorOnPrimary"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

