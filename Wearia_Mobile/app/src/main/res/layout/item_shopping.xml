<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/colorSurfaceCard"
    app:strokeColor="@color/colorBorder"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <!-- Cadre Image -->
            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="115dp"
                android:background="@drawable/bg_clothing_item_preview">

                <ImageView
                    android:id="@+id/iv_article_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:padding="4dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tv_article_nom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chemise Oxford blanche"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/colorTextPrimary" />

                <!-- Raison IA 1 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_sparkle_filled"
                        app:tint="@color/colorPrimary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tv_article_reason1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Idéal pour vos styles favoris"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>

                <!-- Raison IA 2 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_hanger"
                        app:tint="@color/colorSecondary"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tv_article_reason2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Complète 5 pièces de votre dressing"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_article_vendor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_article_prix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="89.00 TND"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bouton Voir suggestion -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_suggestion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Voir la suggestion"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            style="@style/Widget.Wearia.Button.Pill" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
