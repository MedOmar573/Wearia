<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Cadre Image -->
            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_clothing_item_preview">

                <ImageView
                    android:id="@+id/iv_article_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:padding="8dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tv_article_nom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="White Oxford shirt"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/colorTextPrimary" />

                <!-- Raison IA 1 (10.jpg) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎖️"
                        android:textSize="12sp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tv_article_reason1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Matches your casual and elegant styles"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>

                <!-- Raison IA 2 (10.jpg) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧥"
                        android:textSize="12sp"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/tv_article_reason2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Works with 5 items in your wardrobe"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_article_vendor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_article_prix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="89.00 TND"
                    android:textColor="@color/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bouton View suggestion (10.jpg) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_suggestion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="View suggestion"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:includeFontPadding="false"
            app:cornerRadius="25dp"
            app:backgroundTint="@color/colorPrimary"
            android:textColor="@color/colorOnPrimary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
