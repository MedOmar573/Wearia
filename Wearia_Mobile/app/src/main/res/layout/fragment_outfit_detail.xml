<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <!-- Barre Supérieure : Flèche Retour + Titre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Retour"
                app:tint="@color/colorTextPrimary"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Détails de la combinaison"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Carte Résumé de la Tenue -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorSurfaceCard"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_summary_occasion"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Occasion • Université"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        tools:ignore="HardcodedText" />

                    <!-- Bouton Modifier l'occasion / Type -->
                    <ImageView
                        android:id="@+id/btn_edit_occasion"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_edit_note"
                        app:tint="@color/colorPrimary"
                        android:background="@drawable/bg_circle_button"
                        android:contentDescription="Modifier le type"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_summary_style"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Casual"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/badge_haut_text"
                        android:background="@drawable/bg_badge_haut"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_summary_pieces_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Combinaison composée de 3 vêtements"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary"
                    android:layout_marginTop="6dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tv_summary_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Météo adaptée : 19°C · Ensoleillé"
                    android:textSize="12sp"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Titre Section Pièces -->
        <TextView
            android:id="@+id/tv_pieces_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pièces de la combinaison"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="12dp"
            tools:ignore="HardcodedText" />

        <!-- Liste dynamique des pièces de la combinaison -->
        <LinearLayout
            android:id="@+id/layout_pieces_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Bouton pour ajouter une pièce à cette combinaison -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_piece_to_outfit"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:text="Ajouter une pièce à cette combinaison"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconTint="@color/colorPrimary"
            android:textColor="@color/colorPrimary"
            app:strokeColor="@color/colorPrimary"
            app:strokeWidth="1.5dp"
            app:cornerRadius="25dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="28dp"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
