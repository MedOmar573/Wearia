<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <!-- En-tête -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Shopper"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sélectionnez un type de vêtement et votre budget pour obtenir des propositions adaptées à votre profil."
                android:textSize="14sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Badge Compte / Genre actif -->
            <TextView
                android:id="@+id/tv_shopper_account_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profil actif : Homme · Articles Homme &amp; Mixte"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:background="@drawable/bg_badge_haut"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Carte Critères : Type de vêtement + Budget + Couleurs du compte (cercles ronds) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- 01 : Type de vêtement (dynamique depuis la BDD selon le genre du compte) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01  ·  Type de vêtement recherché"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginBottom="8dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_bar"
                        android:paddingHorizontal="10dp">

                        <Spinner
                            android:id="@+id/spinner_shopper_type"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:spinnerMode="dropdown" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_shopper_type_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="Chargement des types de vêtements..."
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />

                    <!-- 02 : Budget maximum par article -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="02  ·  Budget maximum (TND)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_search_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TND"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimary"
                            android:layout_marginEnd="10dp" />

                        <EditText
                            android:id="@+id/et_shopper_budget"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:hint="Montant max par article (ex : 150)"
                            android:textSize="14sp"
                            android:textColor="@color/colorTextPrimary"
                            android:textColorHint="@color/colorTextMuted"
                            android:inputType="numberDecimal"
                            android:imeOptions="actionDone" />
                    </LinearLayout>

                    <!-- Raccourcis budget rapide -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_budgets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_budget_80"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="80 DT"
                                style="@style/Widget.Wearia.ShopperChoiceChip"
                                app:chipCornerRadius="14dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_budget_120"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="120 DT"
                                style="@style/Widget.Wearia.ShopperChoiceChip"
                                app:chipCornerRadius="14dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_budget_150"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="150 DT"
                                android:checked="true"
                                style="@style/Widget.Wearia.ShopperChoiceChip"
                                app:chipCornerRadius="14dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_budget_200"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="200 DT"
                                style="@style/Widget.Wearia.ShopperChoiceChip"
                                app:chipCornerRadius="14dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_budget_300"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="300 DT"
                                style="@style/Widget.Wearia.ShopperChoiceChip"
                                app:chipCornerRadius="14dp" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Couleurs préférées et non préférées associées au compte (cercles ronds) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="@color/colorSurfaceVariant"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/colorBorder"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <!-- Couleurs préférées du compte -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Couleurs préférées"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="8dp" />

                            <HorizontalScrollView
                                android:id="@+id/hsv_preferred_colors"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:scrollbars="none"
                                android:visibility="gone"
                                android:layout_marginBottom="4dp">

                                <LinearLayout
                                    android:id="@+id/ll_preferred_color_circles"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical" />
                            </HorizontalScrollView>

                            <TextView
                                android:id="@+id/tv_preferred_colors_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Aucune enregistrée dans votre profil"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                android:layout_marginBottom="4dp" />

                            <!-- Couleurs non préférées du compte -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Couleurs non préférées"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:layout_marginTop="10dp"
                                android:layout_marginBottom="8dp" />

                            <HorizontalScrollView
                                android:id="@+id/hsv_avoided_colors"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:scrollbars="none"
                                android:visibility="gone">

                                <LinearLayout
                                    android:id="@+id/ll_avoided_color_circles"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical" />
                            </HorizontalScrollView>

                            <TextView
                                android:id="@+id/tv_avoided_colors_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Aucune enregistrée dans votre profil"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Bouton principal -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_generate_outfits"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Rechercher des propositions"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnPrimary"
                        app:icon="@drawable/ic_sparkle"
                        app:iconTint="@color/colorOnPrimary"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:backgroundTint="@color/colorPrimary"
                        app:cornerRadius="24dp"
                        style="@style/Widget.MaterialComponents.Button" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fiches produit réelles vérifiées auprès des boutiques configurées."
                android:textSize="11sp"
                android:textColor="@color/colorTextMuted"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Indicateur de chargement -->
            <LinearLayout
                android:id="@+id/ll_loading_ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:paddingVertical="24dp">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:indeterminateTint="@color/colorPrimary"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tv_loading_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recherche d'articles et vérification des liens..."
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary" />
            </LinearLayout>

            <!-- Titre des propositions -->
            <TextView
                android:id="@+id/tv_outfits_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Propositions trouvées"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Liste des propositions individuelles du type demandé -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_shopper_outfits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_regenerate_outfits"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Voir d'autres propositions"
                android:visibility="gone"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/colorSurfaceCard"
                android:textColor="@color/colorPrimary" />

            <!-- État vide -->
            <TextView
                android:id="@+id/tv_empty_shopper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Choisissez un type de vêtement et votre budget puis cliquez sur « Rechercher des propositions »."
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:gravity="center"
                android:paddingVertical="28dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
