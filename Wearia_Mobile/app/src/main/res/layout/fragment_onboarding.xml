<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="24dp">

    <!-- Logo Wearia élégant au sommet -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="160dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_logo_wearia"
        android:contentDescription="Wearia Logo"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Illustration centrale des vêtements (1.jpg, 2.jpg, 3.jpg) -->
    <ImageView
        android:id="@+id/iv_onboarding_graphic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:src="@drawable/onboarding_graphic_1"
        android:contentDescription="Onboarding illustration"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_logo"
        app:layout_constraintBottom_toTopOf="@id/tv_onboarding_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Titre Serif Élégant -->
    <TextView
        android:id="@+id/tv_onboarding_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Transform your wardrobe"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:textColor="@color/colorTextPrimary"
        android:textAlignment="center"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/tv_onboarding_subtitle" />

    <!-- Sous-titre descriptif -->
    <TextView
        android:id="@+id/tv_onboarding_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Organize your clothes digitally and discover new outfit combinations."
        android:textSize="14sp"
        android:textColor="@color/colorTextSecondary"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="22dp"
        app:layout_constraintBottom_toTopOf="@id/layout_dots" />

    <!-- Indicateurs d'étapes (1) (2) (3) -->
    <LinearLayout
        android:id="@+id/layout_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="22dp"
        app:layout_constraintBottom_toTopOf="@id/btn_onboarding_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dot_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnPrimary"
            android:gravity="center"
            android:background="@drawable/bg_circle_fab"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/dot_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="2"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:gravity="center"
            android:background="@drawable/bg_circle_button"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/dot_3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="3"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:gravity="center"
            android:background="@drawable/bg_circle_button" />
    </LinearLayout>

    <!-- Bouton Next / Get Started (Pill noir mat) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_onboarding_next"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Next"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:includeFontPadding="false"
        app:cornerRadius="28dp"
        app:backgroundTint="@color/colorPrimary"
        android:textColor="@color/colorOnPrimary"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/tv_footer_subtext" />

    <!-- Mention sous le bouton pour l'étape 3 -->
    <TextView
        android:id="@+id/tv_footer_subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalized recommendations, your way."
        android:textSize="12sp"
        android:textColor="@color/colorTextSecondary"
        android:visibility="invisible"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
