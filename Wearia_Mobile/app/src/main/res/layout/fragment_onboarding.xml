<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="24dp">

    <!-- Header avec Logo Wearia -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="150dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_logo_wearia"
        android:contentDescription="Wearia Logo"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Carte Illustration centrale avec ombre douce et coins 28dp -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_graphic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/colorSurface"
        app:strokeColor="@color/colorBorder"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/iv_logo"
        app:layout_constraintBottom_toTopOf="@id/tv_onboarding_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_onboarding_graphic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/onboarding_graphic_1"
            android:contentDescription="Illustration Onboarding" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Titre Principal moderne -->
    <TextView
        android:id="@+id/tv_onboarding_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Révélez votre style"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary"
        android:textAlignment="center"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@id/tv_onboarding_subtitle" />

    <!-- Sous-titre descriptif -->
    <TextView
        android:id="@+id/tv_onboarding_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Organisez votre garde-robe numériquement et composez des tenues parfaites."
        android:textSize="15sp"
        android:textColor="@color/colorTextSecondary"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/layout_dots" />

    <!-- Indicateurs d'étapes (puces modernes) -->
    <LinearLayout
        android:id="@+id/layout_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/btn_onboarding_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dot_1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnPrimary"
            android:gravity="center"
            android:background="@drawable/bg_circle_fab"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/dot_2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="2"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:gravity="center"
            android:background="@drawable/bg_circle_button"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/dot_3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="3"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:gravity="center"
            android:background="@drawable/bg_circle_button" />
    </LinearLayout>

    <!-- Bouton Dégradé Brand Gradient Pill -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_onboarding_next"
        style="@style/Widget.Wearia.Button.Gradient"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Continuer"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/tv_footer_subtext" />

    <!-- Mention sous le bouton pour l'étape 3 -->
    <TextView
        android:id="@+id/tv_footer_subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recommandations sur-mesure selon vos préférences."
        android:textSize="12sp"
        android:textColor="@color/colorTextSecondary"
        android:visibility="invisible"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
