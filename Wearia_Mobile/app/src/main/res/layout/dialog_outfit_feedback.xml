<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="36dp">

        <!-- Barre de poignée Bottom Sheet -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@color/colorBorderStrong"
            android:layout_marginBottom="18dp" />

        <!-- Titre Bottom Sheet -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Votre avis sur cette tenue"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="18dp" />

        <!-- Ligne des 3 réactions tactiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Réaction 1: J'adore -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_reaction_love"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_heart_filled"
                        app:tint="#F43F5E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="J'adore"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Réaction 2: Correct -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_reaction_okay"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_thumb_up"
                        app:tint="@color/colorSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correct"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Réaction 3: Pas pour moi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_reaction_not_for_me"
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/colorSurfaceCard"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_thumb_down"
                        app:tint="@color/colorTextMuted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pas pour moi"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Carte: Que souhaitez-vous modifier ? -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/colorSurfaceCard"
            app:strokeColor="@color/colorBorder"
            app:strokeWidth="1dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Que souhaitez-vous ajuster ?"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginBottom="14dp" />

                <!-- Chips sélectionnables modernes -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_feedback_reasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_reason_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Couleur"
                        style="@style/Widget.Wearia.Chip"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_reason_fit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coupe"
                        style="@style/Widget.Wearia.Chip"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_reason_style"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Style"
                        style="@style/Widget.Wearia.Chip"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_reason_shoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chaussures"
                        style="@style/Widget.Wearia.Chip"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_reason_jacket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Veste"
                        style="@style/Widget.Wearia.Chip"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_reason_warm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trop chaud"
                        style="@style/Widget.Wearia.Chip"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_reason_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trop léger"
                        style="@style/Widget.Wearia.Chip"
                        android:checkable="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_reason_occasion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inadapté à l'occasion"
                        style="@style/Widget.Wearia.Chip"
                        android:checkable="true" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bouton Dégradé Enregistrement Feedback -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_feedback"
            style="@style/Widget.Wearia.Button.Gradient"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Enregistrer mon avis"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Vos retours permettent à l'IA d'affiner ses futures compositions."
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:textAlignment="center" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
