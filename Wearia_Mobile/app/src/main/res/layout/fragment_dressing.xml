<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="24dp">

            <!-- En-tête Dressing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon Dressing"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginBottom="16dp" />

            <!-- Barre de Recherche & Filtre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Champ de recherche style pill avec bordure douce -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginEnd="10dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search_modern"
                        app:tint="@color/colorTextSecondary"
                        android:layout_marginEnd="10dp" />

                    <EditText
                        android:id="@+id/et_search_wardrobe"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="Rechercher une pièce..."
                        android:textSize="14sp"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextMuted"
                        android:imeOptions="actionSearch"
                        android:inputType="text" />
                </LinearLayout>

                <!-- Bouton Filtre Circulaire -->
                <ImageButton
                    android:id="@+id/btn_filter_wardrobe"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_button"
                    android:src="@drawable/ic_filter_modern"
                    app:tint="@color/colorTextPrimary"
                    android:contentDescription="Filtres" />
            </LinearLayout>

            <!-- Chips de Catégories Horizontales -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="14dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_categories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tous"
                        android:checked="true"
                        style="@style/Widget.Wearia.Chip"
                        app:chipCornerRadius="20dp"
                        app:chipBackgroundColor="@color/colorPrimary"
                        android:textColor="@color/colorOnPrimary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_tops"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hauts"
                        style="@style/Widget.Wearia.Chip" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_bottoms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bas"
                        style="@style/Widget.Wearia.Chip" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_dresses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Robes"
                        style="@style/Widget.Wearia.Chip" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_jackets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vestes"
                        style="@style/Widget.Wearia.Chip" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_shoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chaussures"
                        style="@style/Widget.Wearia.Chip" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_accessories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accessoires"
                        style="@style/Widget.Wearia.Chip" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_custom_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Catégorie"
                        style="@style/Widget.Wearia.Chip" />

                    <!-- Anciennes chips pour compatibilité de code -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_available"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_dirty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone"
                android:layout_marginVertical="20dp" />

            <!-- Avertissement Mode Hors-ligne -->
            <TextView
                android:id="@+id/tv_offline_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mode hors-ligne — Affichage du cache local"
                android:background="@drawable/bg_badge_veste"
                android:textColor="@color/badge_veste_text"
                android:padding="10dp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <!-- État vide -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Votre garde-robe est vide.\nTouchez '+' pour ajouter votre première pièce."
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                android:visibility="gone"
                android:padding="32dp" />

            <!-- Grid 2 colonnes des vêtements -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_clothes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="84dp" />
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FAB Dégradé avec '+' -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_clothing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Ajouter un vêtement"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/colorOnPrimary"
        app:fabCustomSize="56dp"
        app:maxImageSize="28dp"
        app:elevation="6dp"
        app:srcCompat="@android:drawable/ic_input_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
