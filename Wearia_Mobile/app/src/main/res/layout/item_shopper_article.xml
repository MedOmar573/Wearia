<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/colorSurfaceCard"
    android:padding="12dp"
    android:layout_marginBottom="1dp">

    <!-- Image produit -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="90dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/iv_shopper_article_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_clothing_item_preview"
            android:scaleType="centerCrop"
            android:contentDescription="Photo article" />
    </FrameLayout>

    <!-- Infos centrales -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Tag catégorie -->
        <TextView
            android:id="@+id/tv_shopper_article_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HAUT"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/badge_haut_text"
            android:background="@drawable/bg_badge_haut"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginBottom="4dp"
            tools:ignore="HardcodedText" />

        <!-- Nom article -->
        <TextView
            android:id="@+id/tv_shopper_article_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="T-shirt Oversize Noir"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:maxLines="2"
            android:ellipsize="end"
            tools:ignore="HardcodedText" />

        <!-- Boutique + Tailles -->
        <TextView
            android:id="@+id/tv_shopper_article_store"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exist · S, M, L"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:ignore="HardcodedText" />

        <!-- Prix -->
        <TextView
            android:id="@+id/tv_shopper_article_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="49.0 TND"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="4dp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Bouton Acheter -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_buy_article"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Voir ↗"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/colorOnPrimary"
        app:backgroundTint="@color/colorPrimary"
        app:cornerRadius="18dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="12dp"
        style="@style/Widget.MaterialComponents.Button" />

</LinearLayout>
